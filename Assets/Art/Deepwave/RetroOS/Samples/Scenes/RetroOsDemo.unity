--- !u!114 &824020253
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 824020250}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8090556ff5c03b24fa5eb75e05f686db, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  osName: RetroOS 95
  theme: {fileID: 0}
  wallpaper: {fileID: 0}
  sounds:
    masterVolume: 1
    uiVolume: 0.7
    musicVolume: 1
    masterAffectsGame: 0
    synthFallback: 1
    click: {fileID: 0}
    windowOpen: {fileID: 0}
    windowClose: {fileID: 0}
    error: {fileID: 0}
    startup: {fileID: 0}
    login: {fileID: 0}
    notify: {fileID: 0}
    discInsert: {fileID: 0}
    discEject: {fileID: 0}
  rules:
  - note: Opening the sealed archive gets noticed
    eventId: node.unlocked
    argument: /C:/Archive
    requiredFlag: 
    once: 1
    actions:
    - kind: 5
      value: watcher
      text: 
      clip: {fileID: 0}
    - kind: 0
      value: archive_opened
      text: 
      clip: {fileID: 0}
  - note: Reading the dead board reveals sandoval's last note
    eventId: web.visited
    argument: hollow.local*
    requiredFlag: 
    once: 1
    actions:
    - kind: 2
      value: /C:/Users/operator/Documents/last_post.txt
      text: 
      clip: {fileID: 0}
    - kind: 0
      value: saw_hollow
      text: 
      clip: {fileID: 0}
  - note: The incident report access is logged
    eventId: file.opened
    argument: /C:/Archive/incident_report.txt
    requiredFlag: 
    once: 1
    actions:
    - kind: 7
      value: SECURITY
      text: 1958 ARCHIVE ACCESS LOGGED.
      clip: {fileID: 0}
  - note: Opening the archive brings UNKNOWN online
    eventId: flag.set
    argument: archive_opened
    requiredFlag: 
    once: 1
    actions:
    - kind: 16
      value: unknown
      text: 
      clip: {fileID: 0}
    - kind: 13
      value: Messenger
      text: UNKNOWN wants to talk to you.
      clip: {fileID: 0}
  - note: The terminal override is noticed too
    eventId: story.override.used
    argument: 
    requiredFlag: 
    once: 1
    actions:
    - kind: 13
      value: SECURITY
      text: Override accepted. This session is being recorded.
      clip: {fileID: 0}
  - note: Reading the sealed report takes the facility site off the air
    eventId: file.opened
    argument: /C:/Archive/incident_report.txt
    requiredFlag: 
    once: 1
    actions:
    - kind: 15
      value: northpoint.local
      text: 
      clip: {fileID: 0}
    - kind: 13
      value: Northpoint Facility
      text: northpoint.local has stopped answering.
      clip: {fileID: 0}
  startFocused: 0
  startPoweredOn: 1
